{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "types": [
      "react"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "index.client.tsx",
    "client/**/*.ts",
    "client/**/*.tsx",
    "shared/**/*.ts",
    "index.server.ts",
    "server/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
